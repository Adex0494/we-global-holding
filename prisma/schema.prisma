generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  phone        String?
  dateOfBirth  DateTime?
  accessStatus AccessStatus @default(NONE)

  businessAccessRequests BusinessAccessRequest[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


enum AccessStatus {
  NONE
  PENDING
  APPROVED
  DENIED
}


model BusinessAccessRequest {
  id                     String   @id @default(uuid())
  userId                 String

  legalCompanyName       String
  incorporationCountry   String
  incorporationState     String
  registrationNumber     String
  companyType            CompanyType
  businessAddress        String
  website                String?
  corporateEmail         String
  industry               String
  description            String
  socialLink             String?
  representativeName     String
  representativePosition String
  interestExplanation    String

  status                 RequestStatus @default(PENDING)
  reviewedBy             String?
  reviewedAt             DateTime?
  adminNotes             String?

  createdAt              DateTime @default(now())

  user                   User @relation(fields: [userId], references: [id])
}

enum CompanyType {
  LLC
  CORP
  SRL
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

